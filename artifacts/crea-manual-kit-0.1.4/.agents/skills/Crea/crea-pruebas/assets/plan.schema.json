{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "A",
              "M",
              "D",
              "R",
              "T",
              "U"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "path",
          "old_path"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "required_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "required",
              "not_applicable",
              "blocked"
            ]
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "check_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "rule_id",
                "reason",
                "check_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "path",
          "decision",
          "matches"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "input_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "files",
              "missing"
            ],
            "additionalProperties": false
          },
          "environment": {
            "enum": [
              "local",
              "spark_local",
              "databricks"
            ]
          },
          "effect": {
            "enum": [
              "local_execution",
              "remote_read",
              "synthetic_write"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "check_id",
          "rule_ids",
          "input_digest",
          "snapshot",
          "environment",
          "effect",
          "argv"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "git_input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "git_input_digest",
        "execution_digest",
        "adapter_digest",
        "project_digest"
      ],
      "additionalProperties": false
    },
    "required_check_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "policy_digest",
    "base_ref",
    "changes",
    "required_criteria",
    "decisions",
    "selected",
    "blockers",
    "status",
    "candidate_digest",
    "plan_id"
  ],
  "additionalProperties": false
}
