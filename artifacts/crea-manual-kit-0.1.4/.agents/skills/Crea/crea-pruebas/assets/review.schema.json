{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "needs_changes",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "correctness",
              "security",
              "performance",
              "tests",
              "style",
              "documentation"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "suggested_action": {
            "enum": [
              "report",
              "warn",
              "block"
            ]
          },
          "effective_stage": {
            "enum": [
              "shadow",
              "warn",
              "block",
              "human"
            ]
          },
          "promotion_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "rule_id",
          "category",
          "file",
          "line",
          "evidence",
          "recommendation",
          "suggested_action",
          "effective_stage",
          "promotion_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "candidate_digest",
    "plan_id",
    "reviewer_id",
    "model",
    "rubric_version",
    "status",
    "findings",
    "coverage_evidence",
    "decision_reason"
  ],
  "additionalProperties": false
}
