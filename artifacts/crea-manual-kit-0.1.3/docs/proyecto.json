    "allow_force_push": false,
    "allow_merge": false,
    "allow_deploy": false,
    "auto_create_pr": false,
    "delete_branch_automatically": false,
    "web_repository_url": null,
    "pr_template": "docs/plantillas/pr.md",
    "procedure": "docs/entrega-git.md",
    "note": "Principal publica el alcance aprobado en feature/<hu>. Azure DevOps Services: crear PR solo si la aprobacion incluye esa accion. auto_create_pr=false prohibe creacion desatendida. Sin auto-complete, merge, borrado, pipelines ni Boards. Mantener la rama hasta completar PR mediante accion posterior.",
    "pr_creation": {
      "azure_devops": "cli_after_explicit_approval",
      "github": "manual_link",
      "other": "manual_link"
    }
