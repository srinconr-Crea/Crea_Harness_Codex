      "planner": [
        "openspec-explore",
        "openspec-propose",
        "openspec-update-change"
      ],
      "developer": [
        "openspec-apply-change"
      ],
      "reviewer": [
        "openspec-verify-change",
        "openspec-sync-specs",
        "openspec-archive-change"
      ]
    },
    "planning_confirmation_policy": "preserve_openspec_skill_gates"
  },
  "validation": {
    "required_checks": [],
    "example_checks": [
      {
        "id": "python-unit",
        "command": "python -m pytest -q",
        "when": "Proyecto Python con pytest instalado y tests definidos"
      },
      {
        "id": "bundle",
        "command": "databricks bundle validate -t dev --profile PERFIL",
        "when": "Existe databricks.yml y se eligieron perfil y target"
      }
    ],
    "no_checks_policy": "planner_define_before_apply",
    "require_runtime_tests_when_spark_changes": true
  },
