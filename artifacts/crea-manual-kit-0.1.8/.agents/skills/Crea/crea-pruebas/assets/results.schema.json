{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "results",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "input_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run",
              "not_applicable"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "collected": {
            "type": "integer",
            "minimum": 0
          },
          "executed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "assertions": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "passed",
                "failed",
                "blocked",
                "not_run"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "environment_id": {
            "type": "string",
            "minLength": 1
          },
          "authorization_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "input_digest",
          "status",
          "exit_code",
          "collected",
          "executed",
          "failed",
          "skipped",
          "assertions",
          "evidence",
          "started_at",
          "finished_at",
          "environment_id",
          "authorization_ref",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "candidate_digest",
    "records"
  ],
  "additionalProperties": false
}
