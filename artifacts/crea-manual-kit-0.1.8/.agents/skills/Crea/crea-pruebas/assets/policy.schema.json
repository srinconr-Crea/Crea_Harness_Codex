{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "setup_complete": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "pytest",
              "assertions",
              "static",
              "bundle",
              "runtime",
              "mutation",
              "sast",
              "eval"
            ]
          },
          "environment": {
            "enum": [
              "local",
              "spark_local",
              "databricks"
            ]
          },
          "effect": {
            "enum": [
              "local_execution",
              "remote_read",
              "synthetic_write"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "configured": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "min_tests": {
            "type": "integer",
            "minimum": 0
          },
          "required_assertions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "reuse_seconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "environment",
          "effect",
          "argv",
          "configured",
          "timeout_seconds",
          "inputs",
          "criteria",
          "min_tests",
          "required_assertions",
          "reuse_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "paths",
          "checks",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "tests",
                  "fixtures",
                  "evals"
                ]
              }
            },
            "required": [
              "path",
              "kind"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "test_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "check_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "uniqueItems": true
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "active",
                  "retired"
                ]
              },
              "expected_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "expected_nodeids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "complete_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "retirement": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_ref": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "replacement_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "uniqueItems": true
                  },
                  "previous_definition": {
                    "type": "object"
                  },
                  "previous_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "source",
                  "reason",
                  "decision_ref",
                  "replacement_ids",
                  "previous_definition",
                  "previous_digest"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "pattern",
              "check_ids",
              "purpose",
              "provenance",
              "state"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "retired"
                    }
                  }
                },
                "then": {
                  "required": [
                    "retirement"
                  ]
                }
              }
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "locations",
        "test_inventory"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "setup_complete",
    "checks",
    "rules"
  ],
  "additionalProperties": false
}
