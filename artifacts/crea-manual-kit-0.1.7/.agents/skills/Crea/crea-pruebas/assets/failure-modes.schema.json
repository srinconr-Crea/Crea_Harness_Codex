{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "failure-modes",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ref": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1
          },
          "test_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "category",
          "requirement_ref",
          "risk",
          "trigger",
          "expected_behavior",
          "test_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "modes"
  ],
  "additionalProperties": false
}
