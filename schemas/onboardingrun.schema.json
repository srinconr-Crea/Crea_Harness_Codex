{
  "$defs": {
    "JournalOperation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "target",
            "binding",
            "state"
          ],
          "title": "Scope",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "state": {
          "enum": [
            "planned",
            "creating",
            "created",
            "failed",
            "removed",
            "conflict"
          ],
          "title": "State",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "file_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Identity"
        }
      },
      "required": [
        "schema_version",
        "scope",
        "kind",
        "path",
        "state"
      ],
      "title": "JournalOperation",
      "type": "object"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "enum": [
            "preflight",
            "collect",
            "preview",
            "prepare",
            "integrate",
            "certify"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_run",
            "in_progress",
            "completed",
            "failed",
            "blocked",
            "recovered",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "schema_version",
        "name",
        "status"
      ],
      "title": "StageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "onboarding_run",
      "default": "onboarding_run",
      "title": "Kind",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "checkout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Checkout Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "target_identity": {
      "title": "Target Identity",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecord"
      },
      "title": "Stages",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/JournalOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "integration_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integration Plan Sha256"
    }
  },
  "required": [
    "schema_version",
    "client_id",
    "checkout_id",
    "run_id",
    "plan_sha256",
    "target_identity",
    "stages",
    "operations"
  ],
  "title": "OnboardingRun",
  "type": "object"
}
