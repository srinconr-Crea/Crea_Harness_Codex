{
  "$defs": {
    "TestCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "technology": {
          "enum": [
            "general",
            "sql",
            "python",
            "notebook",
            "pyspark",
            "yaml-dabs",
            "cicd",
            "harness"
          ],
          "title": "Technology",
          "type": "string"
        },
        "operation": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "input": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Input",
          "type": "string"
        },
        "expected": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "source_rules": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Source Rules",
          "type": "array"
        },
        "implementation_change": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Implementation Change",
          "type": "string"
        },
        "execution_mode": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Execution Mode",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "status": {
          "const": "not_run",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "technology",
        "operation",
        "input",
        "expected",
        "source_rules",
        "implementation_change",
        "execution_mode",
        "critical",
        "status"
      ],
      "title": "TestCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "catalog_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Catalog Id",
      "type": "string"
    },
    "version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "status": {
      "const": "not_run",
      "title": "Status",
      "type": "string"
    },
    "fixture_ref": {
      "title": "Fixture Ref",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/TestCase"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "catalog_id",
    "version",
    "status",
    "fixture_ref",
    "cases"
  ],
  "title": "TestCatalog",
  "type": "object"
}
