{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "role": {
      "enum": [
        "principal",
        "analyst",
        "impact-analyzer",
        "planner",
        "developer",
        "tester",
        "auditor",
        "verifier"
      ],
      "title": "Role",
      "type": "string"
    },
    "actor": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Actor",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Sha256"
    },
    "sources": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$": {
          "enum": [
            "user",
            "local",
            "template"
          ],
          "type": "string"
        }
      },
      "title": "Sources",
      "type": "object"
    },
    "decisions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Decisions",
      "type": "array"
    },
    "findings": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Findings",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "not_run"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "role",
    "actor",
    "plan_sha256",
    "sources",
    "decisions",
    "findings",
    "status"
  ],
  "title": "Handoff",
  "type": "object"
}
