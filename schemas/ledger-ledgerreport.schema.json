{
  "$defs": {
    "ActivityEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Client Id",
          "type": "string"
        },
        "checkout_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Checkout Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Operation Id",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "source": {
          "enum": [
            "harness_commands",
            "imported",
            "hooks"
          ],
          "title": "Source",
          "type": "string"
        },
        "scope": {
          "enum": [
            "setup",
            "hu"
          ],
          "title": "Scope",
          "type": "string"
        },
        "hu_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hu Id"
        },
        "attempt": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "kind": {
          "enum": [
            "start",
            "result",
            "retry",
            "test",
            "gate",
            "annotation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "maxLength": 64,
          "title": "Observed At",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha256"
        },
        "request_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Sha256"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "action": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "redacted": {
          "default": false,
          "title": "Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "client_id",
        "checkout_id",
        "event_id",
        "operation_id",
        "idempotency_key",
        "source",
        "scope",
        "kind",
        "observed_at"
      ],
      "title": "ActivityEvent",
      "type": "object"
    },
    "UsageObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Client Id",
          "type": "string"
        },
        "hu_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Hu Id",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "source": {
          "enum": [
            "unavailable",
            "supported-session-receipt"
          ],
          "title": "Source",
          "type": "string"
        },
        "scope": {
          "enum": [
            "hu",
            "session",
            "account"
          ],
          "title": "Scope",
          "type": "string"
        },
        "surface": {
          "default": "desktop",
          "enum": [
            "desktop",
            "cli",
            "harness-local"
          ],
          "title": "Surface",
          "type": "string"
        },
        "observed_at": {
          "maxLength": 64,
          "title": "Observed At",
          "type": "string"
        },
        "native_session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Session Id"
        },
        "documentation_ref": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentation Ref"
        },
        "association_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Association Ref"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "cached_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Tokens"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "token_unit": {
          "const": "tokens",
          "default": "tokens",
          "title": "Token Unit",
          "type": "string"
        },
        "cost_unit": {
          "const": "USD",
          "default": "USD",
          "title": "Cost Unit",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "checkout_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Checkout Id",
          "type": "string"
        },
        "source_event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Source Event Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "period_start": {
          "maxLength": 64,
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "maxLength": 64,
          "title": "Period End",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "client_id",
        "hu_id",
        "attempt",
        "source",
        "scope",
        "observed_at",
        "reason",
        "checkout_id",
        "source_event_id",
        "period_start",
        "period_end"
      ],
      "title": "UsageObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "checkout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Checkout Id",
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ActivityEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/UsageObservation"
      },
      "title": "Usage",
      "type": "array"
    },
    "incomplete_operations": {
      "title": "Incomplete Operations",
      "type": "integer"
    },
    "failed_operations": {
      "title": "Failed Operations",
      "type": "integer"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "number"
    },
    "incomplete_durations": {
      "default": 0,
      "title": "Incomplete Durations",
      "type": "integer"
    },
    "blocked_operations": {
      "default": 0,
      "title": "Blocked Operations",
      "type": "integer"
    },
    "retries": {
      "default": 0,
      "title": "Retries",
      "type": "integer"
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "unavailable_reason": {
      "default": "supported_attributable_source_unavailable",
      "title": "Unavailable Reason",
      "type": "string"
    },
    "measurement_conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Conflicts",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Coverage",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "client_id",
    "checkout_id",
    "counts",
    "events",
    "usage",
    "incomplete_operations",
    "failed_operations",
    "duration_ms",
    "coverage"
  ],
  "title": "LedgerReport",
  "type": "object"
}
