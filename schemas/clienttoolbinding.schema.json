{
  "$defs": {
    "ToolConnection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "local",
            "cli",
            "mcp",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "connection_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Connection Ref"
        },
        "status": {
          "enum": [
            "declared",
            "unavailable",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "connection_ref",
        "status"
      ],
      "title": "ToolConnection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "client_tool_binding",
      "default": "client_tool_binding",
      "title": "Kind",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "checkout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Checkout Id",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolConnection"
      },
      "maxItems": 64,
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "client_id",
    "checkout_id",
    "tools"
  ],
  "title": "ClientToolBinding",
  "type": "object"
}
