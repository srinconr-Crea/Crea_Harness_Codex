{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "actor": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Actor",
      "type": "string"
    },
    "confirmed": {
      "title": "Confirmed",
      "type": "boolean"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "checkout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Checkout Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "approved_at": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Approved At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "actor",
    "confirmed",
    "client_id",
    "checkout_id",
    "attempt",
    "revision",
    "plan_sha256",
    "approved_at"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
