{
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "actor": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Actor",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Client Id",
          "type": "string"
        },
        "checkout_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Checkout Id",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "approved_at": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Approved At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "actor",
        "confirmed",
        "client_id",
        "checkout_id",
        "attempt",
        "revision",
        "plan_sha256",
        "approved_at"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "role": {
          "enum": [
            "principal",
            "analyst",
            "impact-analyzer",
            "planner",
            "developer",
            "tester",
            "auditor",
            "verifier"
          ],
          "title": "Role",
          "type": "string"
        },
        "write_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Write Paths",
          "type": "array"
        },
        "isolation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Isolation",
          "type": "string"
        },
        "delegation_depth": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Delegation Depth",
          "type": "integer"
        },
        "actor": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Actor",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "role",
        "write_paths",
        "isolation",
        "actor"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "base": {
          "title": "Base",
          "type": "string"
        },
        "baseline_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Sha256",
          "type": "string"
        },
        "context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/CandidateEntry"
          },
          "maxItems": 256,
          "title": "Entries",
          "type": "array"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "base",
        "baseline_sha256",
        "context_sha256",
        "plan_sha256",
        "entries",
        "candidate_sha256"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateEntry": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "operation": {
          "enum": [
            "create",
            "modify",
            "delete"
          ],
          "title": "Operation",
          "type": "string"
        },
        "base_oid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Oid"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Sha256"
        },
        "index_oid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Index Oid"
        },
        "index_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Index Mode"
        },
        "staged_operation": {
          "anyOf": [
            {
              "enum": [
                "create",
                "modify",
                "delete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Staged Operation"
        }
      },
      "required": [
        "schema_version",
        "path",
        "operation",
        "base_oid",
        "content_sha256",
        "index_oid",
        "index_mode",
        "staged_operation"
      ],
      "title": "CandidateEntry",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "actor": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Actor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "test",
            "review",
            "capability"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Evidence Ref",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "candidate_sha256",
        "status",
        "simulated",
        "actor",
        "kind",
        "evidence_ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Handoff": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "role": {
          "enum": [
            "principal",
            "analyst",
            "impact-analyzer",
            "planner",
            "developer",
            "tester",
            "auditor",
            "verifier"
          ],
          "title": "Role",
          "type": "string"
        },
        "actor": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Actor",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha256"
        },
        "sources": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$": {
              "enum": [
                "user",
                "local",
                "template"
              ],
              "type": "string"
            }
          },
          "title": "Sources",
          "type": "object"
        },
        "decisions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Decisions",
          "type": "array"
        },
        "findings": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Findings",
          "type": "array"
        },
        "status": {
          "enum": [
            "completed",
            "blocked",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "role",
        "actor",
        "plan_sha256",
        "sources",
        "decisions",
        "findings",
        "status"
      ],
      "title": "Handoff",
      "type": "object"
    },
    "PlanRevision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "criteria": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "operations": {
          "items": {
            "enum": [
              "create",
              "modify",
              "delete"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "tests": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Tests",
          "type": "array"
        },
        "required_capabilities": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Required Capabilities",
          "type": "array"
        },
        "max_delegations": {
          "default": 2,
          "maximum": 4,
          "minimum": 0,
          "title": "Max Delegations",
          "type": "integer"
        },
        "allow_worktrees": {
          "default": false,
          "title": "Allow Worktrees",
          "type": "boolean"
        },
        "sources": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$": {
              "enum": [
                "user",
                "local",
                "template"
              ],
              "type": "string"
            }
          },
          "title": "Sources",
          "type": "object"
        },
        "decisions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Decisions",
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "criteria",
        "paths",
        "operations",
        "tests",
        "revision",
        "context_sha256",
        "plan_sha256"
      ],
      "title": "PlanRevision",
      "type": "object"
    },
    "RoleCatalog": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "catalog_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Catalog Version",
          "type": "string"
        },
        "practice_pack_version": {
          "title": "Practice Pack Version",
          "type": "string"
        },
        "max_concurrent": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Concurrent",
          "type": "integer"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleProfile"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "practice_pack_version",
        "max_concurrent",
        "roles"
      ],
      "title": "RoleCatalog",
      "type": "object"
    },
    "RoleProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "enum": [
            "principal",
            "analyst",
            "impact-analyzer",
            "planner",
            "developer",
            "tester",
            "auditor",
            "verifier"
          ],
          "title": "Id",
          "type": "string"
        },
        "responsibility": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Responsibility",
          "type": "string"
        },
        "inputs": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "write_scope": {
          "enum": [
            "assigned-only",
            "none"
          ],
          "title": "Write Scope",
          "type": "string"
        },
        "sandbox": {
          "enum": [
            "read-only",
            "workspace-write"
          ],
          "title": "Sandbox",
          "type": "string"
        },
        "delegate_when": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Delegate When",
          "type": "string"
        },
        "max_delegation_depth": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Delegation Depth",
          "type": "integer"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolRequirement"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Tools",
          "type": "array"
        },
        "practice_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Practice Ids",
          "type": "array"
        },
        "activated": {
          "default": false,
          "title": "Activated",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "required": [
        "schema_version",
        "id",
        "responsibility",
        "inputs",
        "outputs",
        "write_scope",
        "sandbox",
        "delegate_when",
        "max_delegation_depth",
        "tools",
        "practice_ids"
      ],
      "title": "RoleProfile",
      "type": "object"
    },
    "ToolRequirement": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "local",
            "skill",
            "mcp",
            "cli"
          ],
          "title": "Kind",
          "type": "string"
        },
        "purpose": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "purpose",
        "required"
      ],
      "title": "ToolRequirement",
      "type": "object"
    },
    "WorktreeRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "branch": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Branch",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "target_identity": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Target Identity",
          "type": "string"
        },
        "base": {
          "title": "Base",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "path",
        "branch",
        "confirmed",
        "target_identity",
        "base"
      ],
      "title": "WorktreeRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "hu_run",
      "default": "hu_run",
      "title": "Kind",
      "type": "string"
    },
    "story_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Story Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "checkout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Checkout Id",
      "type": "string"
    },
    "target_identity": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Target Identity",
      "type": "string"
    },
    "onboarding_plan": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Onboarding Plan",
      "type": "string"
    },
    "writer_actor": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Writer Actor",
      "type": "string"
    },
    "catalog": {
      "$ref": "#/$defs/RoleCatalog"
    },
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "state": {
      "default": "draft",
      "enum": [
        "draft",
        "analyzing",
        "planned",
        "approved",
        "implementing",
        "validating",
        "reviewing",
        "ready_to_publish",
        "published",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "simulation": {
      "title": "Simulation",
      "type": "boolean"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "base": {
      "title": "Base",
      "type": "string"
    },
    "baseline_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 4096,
      "title": "Baseline Files",
      "type": "object"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanRevision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Candidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 256,
      "title": "Evidence",
      "type": "array"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "maxItems": 4,
      "title": "Assignments",
      "type": "array"
    },
    "handoffs": {
      "items": {
        "$ref": "#/$defs/Handoff"
      },
      "maxItems": 128,
      "title": "Handoffs",
      "type": "array"
    },
    "corrections": {
