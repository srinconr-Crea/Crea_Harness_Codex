{
  "$defs": {
    "DesktopObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "role": {
          "enum": [
            "principal",
            "analyst",
            "impact-analyzer",
            "planner",
            "developer",
            "tester",
            "auditor",
            "verifier"
          ],
          "title": "Role",
          "type": "string"
        },
        "surface": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Surface",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "unsupported",
            "not_checked",
            "unavailable",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "default": "desktop",
          "enum": [
            "desktop",
            "cli",
            "files"
          ],
          "title": "Source",
          "type": "string"
        },
        "evidence_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "effective_sandbox": {
          "anyOf": [
            {
              "enum": [
                "read-only",
                "workspace-write",
                "unrestricted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Sandbox"
        }
      },
      "required": [
        "schema_version",
        "role",
        "surface",
        "status",
        "evidence_ref"
      ],
      "title": "DesktopObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "desktop_certificate",
      "default": "desktop_certificate",
      "title": "Kind",
      "type": "string"
    },
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "app_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "App Version",
      "type": "string"
    },
    "engine_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "account_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Account Ref",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/DesktopObservation"
      },
      "maxItems": 256,
      "title": "Observations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "catalog_sha256",
    "app_version",
    "engine_version",
    "account_ref",
    "observations"
  ],
  "title": "DesktopCertificate",
  "type": "object"
}
