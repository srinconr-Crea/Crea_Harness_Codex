    },
    "conventions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Conventions",
      "type": "array"
    },
    "business_rules": {
      "items": {
        "maxLength": 4096,
