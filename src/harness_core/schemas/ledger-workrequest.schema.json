{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "criteria": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Paths",
      "type": "array"
    },
    "operations": {
      "items": {
        "enum": [
          "create",
          "modify",
          "delete"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "tests": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    },
    "required_capabilities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Required Capabilities",
      "type": "array"
    },
    "max_delegations": {
      "default": 2,
      "maximum": 4,
      "minimum": 0,
      "title": "Max Delegations",
      "type": "integer"
    },
    "allow_worktrees": {
      "default": false,
      "title": "Allow Worktrees",
      "type": "boolean"
    },
    "sources": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$": {
          "enum": [
            "user",
            "local",
            "template"
          ],
          "type": "string"
        }
      },
      "title": "Sources",
      "type": "object"
    },
    "decisions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Decisions",
      "type": "array"
    },
    "story_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Story Id",
      "type": "string"
    },
    "story": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Story",
      "type": "string"
    },
    "onboarding_plan": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Onboarding Plan"
    },
    "writer_actor": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Writer Actor",
      "type": "string"
    },
    "mode": {
      "enum": [
        "native",
        "supervised_single_agent"
      ],
      "title": "Mode",
      "type": "string"
    },
    "available_models": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Available Models",
      "type": "object"
    },
    "delegation_available": {
      "default": false,
      "title": "Delegation Available",
      "type": "boolean"
    },
    "isolation_observed": {
      "default": false,
      "title": "Isolation Observed",
      "type": "boolean"
    },
    "native_task_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 4,
      "title": "Native Task Refs",
      "type": "array"
    },
    "requires_independence": {
      "default": false,
      "title": "Requires Independence",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "criteria",
    "paths",
    "operations",
    "tests",
    "story_id",
    "story",
    "writer_actor",
    "mode",
    "available_models"
  ],
  "title": "WorkRequest",
  "type": "object"
}
