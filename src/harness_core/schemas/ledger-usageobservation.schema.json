{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "hu_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Hu Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "source": {
      "enum": [
        "unavailable",
        "supported-session-receipt"
      ],
      "title": "Source",
      "type": "string"
    },
    "scope": {
      "enum": [
        "hu",
        "session",
        "account"
      ],
      "title": "Scope",
      "type": "string"
    },
    "surface": {
      "default": "desktop",
      "enum": [
        "desktop",
        "cli",
        "harness-local"
      ],
      "title": "Surface",
      "type": "string"
    },
    "observed_at": {
      "maxLength": 64,
      "title": "Observed At",
      "type": "string"
    },
    "native_session_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Session Id"
    },
    "documentation_ref": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documentation Ref"
    },
    "association_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Association Ref"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "cached_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cached Tokens"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "token_unit": {
      "const": "tokens",
      "default": "tokens",
      "title": "Token Unit",
      "type": "string"
    },
    "cost_unit": {
      "const": "USD",
      "default": "USD",
      "title": "Cost Unit",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "checkout_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Checkout Id",
      "type": "string"
    },
    "source_event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Source Event Id",
      "type": "string"
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "period_start": {
      "maxLength": 64,
      "title": "Period Start",
      "type": "string"
    },
    "period_end": {
      "maxLength": 64,
      "title": "Period End",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "client_id",
    "hu_id",
    "attempt",
    "source",
    "scope",
    "observed_at",
    "reason",
    "checkout_id",
    "source_event_id",
    "period_start",
    "period_end"
  ],
  "title": "UsageObservation",
  "type": "object"
}
