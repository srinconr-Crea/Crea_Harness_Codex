{
  "$defs": {
    "ValidationTest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "test_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Test Id",
          "type": "string"
        },
        "technology": {
          "enum": [
            "general",
            "sql",
            "python",
            "notebook",
            "pyspark",
            "yaml-dabs",
            "cicd",
            "harness"
          ],
          "title": "Technology",
          "type": "string"
        },
        "layer": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ],
          "title": "Layer",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "scope": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "test_id",
        "technology",
        "layer",
        "required",
        "scope"
      ],
      "title": "ValidationTest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "plan_revision": {
      "minimum": 1,
      "title": "Plan Revision",
      "type": "integer"
    },
    "practice_pack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Practice Pack Sha256",
      "type": "string"
    },
    "technologies": {
      "items": {
        "enum": [
          "general",
          "sql",
          "python",
          "notebook",
          "pyspark",
          "yaml-dabs",
          "cicd",
          "harness"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Technologies",
      "type": "array"
    },
    "impacts": {
      "items": {
        "enum": [
          "logic",
          "delta",
          "runtime",
          "integration",
          "performance"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Impacts",
      "type": "array"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/ValidationTest"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    },
    "catalog_test_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Catalog Test Ids",
      "type": "array"
    },
    "performance_baseline_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Performance Baseline Sha256"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "client_id",
    "run_id",
    "attempt",
    "candidate_sha256",
    "plan_revision",
    "practice_pack_sha256",
    "technologies",
    "impacts",
    "tests",
    "catalog_test_ids",
    "plan_sha256"
  ],
  "title": "ValidationPlan",
  "type": "object"
}
