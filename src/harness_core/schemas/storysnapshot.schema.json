{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Repository",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    },
    "revision": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "title": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "criteria": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "refs": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Refs",
      "type": "array"
    },
    "trust": {
      "const": "external_data",
      "default": "external_data",
      "title": "Trust",
      "type": "string"
    },
    "acceptance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acceptance Sha256",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "source_id",
    "revision",
    "title",
    "criteria",
    "refs",
    "acceptance_sha256",
    "snapshot_sha256"
  ],
  "title": "StorySnapshot",
  "type": "object"
}
